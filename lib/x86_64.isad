COUNT=256
OPCODE_LENGTH=0 
DEFAULT_BIT_WIDTH=32

$opcode: "[mnemonic]" $FLAGS

FLAGS: 

FLAGS = {
F_NONE     
F_MODRM  
F_SIB    
F_IMM8    
F_IMM32   
F_GROUP   
F_REX  
F_PREFIX
F_REG_BITS
}

OPERANDS:

REG_8_SHORT:8:4 {
000=al
001=cl
010=bl
011=dl
100=ah
101=ch
110=dh
111=bh
}

REG_8_REX:8:4 {
100=spl
101=bpl
110=sil
111=dil
}

REG_16:8:4 { 
000=ax
001=cx
010=dx
011=bx
100=sp
101=bp
110=si
111=di
}

REG_32:8:4 {  
000=eax
001=ecx
010=edx
011=ebx
100=esp
101=ebp
110=esi
111=edi
}

REG_64:16:4 {
000=rax
001=rcx
010=rdx
011=rbx
100=rsp
101=rbp
110=rsi
111=rdi
1000=r8
1001=r9
1010=r10
1011=r11
1100=r12
1101=r13
1110=r14
1111=r15
}

OPCODES: 

OPCODE_TABLE {
01: "add",F_MODRM

48: NULL,F_PREFIX|F_REX

55: "push %rbp",F_NONE
5d: "pop %rbp",F_NONE

83: "addl",F_MODRM
89: "mov",F_MODRM
8b: "mov",F_MODRM

b8: "mov",F_IMM32|F_REG_BITS 

c3: "ret",F_NONE
c7: "movl",F_MODRM
}

