FLAGS = {
F_NONE 
F_BITS_EIGHT
F_MODRM 
F_SIB    
F_IMM8    
F_IMM32   
F_GROUP   
F_REX  
F_PREFIX
F_REG_BITS
F_ESCAPE
}end

STRUCTURES:

STRUCTURES = {
enum selector {
    SEL_NONE,
    SEL_NEXT_BYTE,
    SEL_MODRM_REG,
    SEL_PREFIX,
    SEL_REX_W
};

struct opcode {
    const char* mnemonic;
    uint32_t flags;
    uint8_t operands[4];
    enum selector sel;
    struct opcode* next;
};

typedef struct MODRM_STRUCT {
    uint8_t mod;
    uint8_t rm;
    uint8_t reg;
    int has_sib;
    uint8_t sib;
    uint32_t disp;
}Modrm;

typedef struct REX_STRUCT {
    uint8_t W;
    uint8_t R;
    uint8_t X;
    uint8_t B;
}REX;

struct Instruction {
    uint8_t prefixes[4];
    uint8_t has_prefix;
    REX rex;
    struct opcode* op;
    Modrm modrm;
    uint8_t has_modrm;
    int64_t disp;
    uint8_t has_disp;
    int64_t imm;
    uint8_t has_imm;
    size_t length;
};
}end

